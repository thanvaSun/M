local originalLighting = {
	GlobalShadows = Lighting.GlobalShadows,
	FogEnd = Lighting.FogEnd,
	Brightness = Lighting.Brightness,
	Technology = Lighting.Technology,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
}

local originalPartData = {}
local hiddenInstances = {}

local function applyPotatoGraphics()
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 100000
	Lighting.Technology = Enum.Technology.Compatibility
	Lighting.Brightness = 1
	Lighting.Ambient = Color3.fromRGB(150, 150, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			originalPartData[obj] = {
				Material = obj.Material,
				Reflectance = obj.Reflectance,
				CastShadow = obj.CastShadow,
			}
			obj.Material = Enum.Material.SmoothPlastic
			obj.Reflectance = 0
			obj.CastShadow = false

		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			hiddenInstances[obj] = obj.Transparency
			obj.Transparency = 1

		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
			or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
			hiddenInstances[obj] = obj.Enabled
			obj.Enabled = false
		end
	end
end

local function restoreGraphics()
	Lighting.GlobalShadows = originalLighting.GlobalShadows
	Lighting.FogEnd = originalLighting.FogEnd
	Lighting.Brightness = originalLighting.Brightness
	Lighting.Technology = originalLighting.Technology
	Lighting.Ambient = originalLighting.Ambient
	Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient

	for obj, data in pairs(originalPartData) do
		if obj and obj.Parent then
			obj.Material = data.Material
			obj.Reflectance = data.Reflectance
			obj.CastShadow = data.CastShadow
		end
	end
	originalPartData = {}

	for obj, value in pairs(hiddenInstances) do
		if obj and obj.Parent then
			if obj:IsA("Decal") or obj:IsA("Texture") then
				obj.Transparency = value
			else
				obj.Enabled = value
			end
		end
	end
	hiddenInstances = {}
end

