-- ===== ฟังก์ชันความเร็ววิ่ง =====
local function applyWalkSpeed()
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local num = tonumber(walkBox.Text)
    if num then
        num = math.clamp(num, 0, 500)
        humanoid.WalkSpeed = num
        walkLabel.Text = "ความเร็ววิ่ง: " .. num
    else
        walkLabel.Text = "กรุณาใส่ตัวเลข"
    end
end

walkApplyBtn.MouseButton1Click:Connect(applyWalkSpeed)
walkBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then applyWalkSpeed() end
end)

