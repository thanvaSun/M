-- ===== ระบบลากไอคอน + คลิกเปิด UI (แก้แล้ว: ล็อคยังกดเปิด UI ได้) =====
local dragging = false
local dragStartPos = nil
local iconStartPos = nil
local totalMoved = 0

toggleIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        totalMoved = 0
        dragStartPos = input.Position
        iconStartPos = toggleIcon.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if iconLocked then return end -- ล็อคอยู่ = ห้ามขยับตำแหน่ง แต่ยังกดเปิด UI ได้
        local delta = input.Position - dragStartPos
        totalMoved = delta.Magnitude
        toggleIcon.Position = UDim2.new(
            iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X,
            iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y
        )
        updateLockBtnPosition()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = false
        if totalMoved < 5 then
            frame.Visible = true
            toggleIcon.Visible = false
            lockBtn.Visible = false
        end
    end
end)

