    local targetPos = isExpanded
        and UDim2.new(0, 40, 0.5, 0)
        or UDim2.new(0, -PANEL_WIDTH - 10, 0.5, 0)
    toggleBar.Text = isExpanded and "◀" or "▶"

    TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
end
