-- ฟังก์ชันสร้างแถวปรับค่า
local sliderYStart = 75
local function createSlider(labelText, key, step, minVal, maxVal, yPos)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 45)
    container.Position = UDim2.new(0, 0, 0, yPos)
    container.BackgroundTransparency = 1
    container.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.Text = labelText .. ": " .. tostring(settings[key])
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1,1,1)
    label.Font = Enum.Font.SourceSans
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 40, 0, 24)
    minusBtn.Position = UDim2.new(0, 0, 0, 20)
    minusBtn.Text = "-"
    minusBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
    minusBtn.TextColor3 = Color3.new(1,1,1)
    minusBtn.Parent = container

    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 40, 0, 24)
    plusBtn.Position = UDim2.new(0, 48, 0, 20)
    plusBtn.Text = "+"
    plusBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
    plusBtn.TextColor3 = Color3.new(1,1,1)
    plusBtn.Parent = container

    local function updateLabel()
        local val = settings[key]
        if step < 1 then
            label.Text = labelText .. ": " .. string.format("%.2f", val)
        else
            label.Text = labelText .. ": " .. tostring(val)
        end
    end

    minusBtn.MouseButton1Click:Connect(function()
        settings[key] = math.clamp(settings[key] - step, minVal, maxVal)
        updateLabel()
    end)

    plusBtn.MouseButton1Click:Connect(function()
        settings[key] = math.clamp(settings[key] + step, minVal, maxVal)
        updateLabel()
    end)
end

createSlider("ความแรงดึง", "ASSIST_STRENGTH", 0.05, 0, 1, sliderYStart)
