local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- ===== ตั้งค่า =====
local settings = {
    enabled = true,
    ASSIST_STRENGTH = 0.9,
    MIN_LOCK_DISTANCE = 5,
    MAX_LOCK_DISTANCE = 500,
}

local manualTarget = nil

-- ===== หาผู้เล่นที่ใกล้ที่สุดในระยะที่กำหนด =====
local function findBestTarget(originPos)
    local bestTarget = nil
    local bestDistance = settings.MAX_LOCK_DISTANCE

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = plr.Character:FindFirstChild("Humanoid")
            if hrp and humanoid and humanoid.Health > 0 then
                local distance = (hrp.Position - originPos).Magnitude
                if distance >= settings.MIN_LOCK_DISTANCE and distance <= bestDistance then
                    bestDistance = distance
                    bestTarget = hrp
                end
            end
        end
    end

    return bestTarget
end

-- ===== ระบบดึงกล้อง =====
RunService:BindToRenderStep("AimAssist", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not settings.enabled then return end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local targetHRP = nil

    if manualTarget and manualTarget.Character then
        local mHRP = manualTarget.Character:FindFirstChild("HumanoidRootPart")
        local mHum = manualTarget.Character:FindFirstChild("Humanoid")
        if mHRP and mHum and mHum.Health > 0 then
            local distance = (mHRP.Position - camera.CFrame.Position).Magnitude
            if distance >= settings.MIN_LOCK_DISTANCE and distance <= settings.MAX_LOCK_DISTANCE then
                targetHRP = mHRP
            end
        end
    else
        targetHRP = findBestTarget(camera.CFrame.Position)
    end

    if not targetHRP then return end

    local currentLook = camera.CFrame.LookVector
    local toTarget = (targetHRP.Position - camera.CFrame.Position).Unit
    local blended = currentLook:Lerp(toTarget, settings.ASSIST_STRENGTH)

    camera.CFrame = CFrame.new(camera.CFrame.Position, camera.CFrame.Position + blended)
end)

