loadstring([[
-- Rayfield UI Library Loader
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Services & Variables
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = Workspace.CurrentCamera

local aimlockEnabled = false
local shiftLockActive = false
local autoWarpEnabled = false
local selectedTargetOption = "[คนใกล้ที่สุด / Closest]"

-- =========================================================
-- 1. FLOATING SQUARE BUTTON (ปุ่มย่อ/เปิด Rayfield UI)
-- =========================================================
if playerGui:FindFirstChild("RayfieldSquareToggle") then
    playerGui.RayfieldSquareToggle:Destroy()
end

local squareGui = Instance.new("ScreenGui")
squareGui.Name = "RayfieldSquareToggle"
squareGui.ResetOnSpawn = false
squareGui.Parent = playerGui

local squareBtn = Instance.new("TextButton")
squareBtn.Name = "SquareButton"
squareBtn.Size = UDim2.new(0, 42, 0, 42)
squareBtn.Position = UDim2.new(0, 15, 0.35, 0)
squareBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
squareBtn.Text = "RF"
squareBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
squareBtn.Font = Enum.Font.GothamBold
squareBtn.TextSize = 13
squareBtn.Parent = squareGui

Instance.new("UICorner", squareBtn).CornerRadius = UDim.new(0, 8)
local sStroke = Instance.new("UIStroke", squareBtn)
sStroke.Color = Color3.fromRGB(0, 170, 255)
sStroke.Thickness = 2

-- Draggable Logic (RF Button)
local dragging1, dragStart1, startPos1
squareBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging1 = true
        dragStart1 = input.Position
        startPos1 = squareBtn.Position
    end
end)
squareBtn.InputChanged:Connect(function(input)
    if dragging1 and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragStart1
        squareBtn.Position = UDim2.new(startPos1.X.Scale, startPos1.X.Offset + delta.X, startPos1.Y.Scale, startPos1.Y.Offset + delta.Y)
    end
end)
squareBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging1 = false
    end
end)

squareBtn.MouseButton1Click:Connect(function()
    local coreGui = game:GetService("CoreGui")
    local rfGui = coreGui:FindFirstChild("Rayfield") or playerGui:FindFirstChild("Rayfield")
    if rfGui then
        rfGui.Enabled = not rfGui.Enabled
    end
end)

-- =========================================================
-- 2. TSBG SHIFT LOCK MOBILE BUTTON (ปุ่มชิฟต์ล็อคแบบแมพสะตองเก็ต)
-- =========================================================
if playerGui:FindFirstChild("TSBGShiftLockGui") then
    playerGui.TSBGShiftLockGui:Destroy()
end

local shiftGui = Instance.new("ScreenGui")
shiftGui.Name = "TSBGShiftLockGui"
shiftGui.ResetOnSpawn = false
shiftGui.Parent = playerGui

local shiftBtn = Instance.new("TextButton")
shiftBtn.Name = "ShiftLockButton"
shiftBtn.Size = UDim2.new(0, 50, 0, 50)
shiftBtn.Position = UDim2.new(0.85, -25, 0.6, 0)
shiftBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
shiftBtn.Text = "🔒"
shiftBtn.TextSize = 22
shiftBtn.Parent = shiftGui

Instance.new("UICorner", shiftBtn).CornerRadius = UDim.new(1, 0)
local shiftStroke = Instance.new("UIStroke", shiftBtn)
shiftStroke.Color = Color3.fromRGB(150, 150, 150)
shiftStroke.Thickness = 2

-- Draggable Logic (ShiftLock Button)
local dragging2, dragStart2, startPos2
shiftBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging2 = true
        dragStart2 = input.Position
        startPos2 = shiftBtn.Position
    end
end)
shiftBtn.InputChanged:Connect(function(input)
    if dragging2 and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragStart2
        shiftBtn.Position = UDim2.new(startPos2.X.Scale, startPos2.X.Offset + delta.X, startPos2.Y.Scale, startPos2.Y.Offset + delta.Y)
    end
end)
shiftBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging2 = false
    end
end)

-- Shift Lock Toggle Function
local function toggleShiftLock(state)
    shiftLockActive = (state ~= nil) and state or not shiftLockActive
    if shiftLockActive then
        shiftBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        shiftStroke.Color = Color3.fromRGB(255, 255, 255)
    else
        shiftBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        shiftStroke.Color = Color3.fromRGB(150, 150, 150)
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.AutoRotate = true
        end
    end
end

shiftBtn.MouseButton1Click:Connect(function()
    toggleShiftLock()
end)

-- =========================================================
-- 3. RAYFIELD WINDOW SETUP
-- =========================================================
local Window = Rayfield:CreateWindow({
   Name = "Rayfield Interface",
   LoadingTitle = "กำลังโหลด...",
   LoadingSubtitle = "ระบบล็อคเป้า & TSBG Shift Lock",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

local MainTab = Window:CreateTab("Combat & Target", 4483362458)

local targetLabel = MainTab:CreateLabel("🎯 เป้าหมาย: ไม่พบผู้เล่นใกล้เคียง")

local function getPlayerNames()
    local list = {"[คนใกล้ที่สุด / Closest]"}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            table.insert(list, plr.DisplayName .. " (@" .. plr.Name .. ")")
        end
    end
    return list
end

local PlayerDropdown = MainTab:CreateDropdown({
   Name = "เลือกคนที่จะล็อค / วาร์ป",
   Options = getPlayerNames(),
   CurrentOption = {"[คนใกล้ที่สุด / Closest]"},
   MultipleOptions = false,
   Flag = "TargetDropdown",
   Callback = function(Option)
       if type(Option) == "table" then
           selectedTargetOption = Option[1] or "[คนใกล้ที่สุด / Closest]"
       else
           selectedTargetOption = Option
       end
   end,
})

MainTab:CreateButton({
   Name = "🔄 อัปเดตรายชื่อคนในเซิร์ฟ",
   Callback = function()
       PlayerDropdown:Refresh(getPlayerNames())
   end,
})

MainTab:CreateToggle({
   Name = "Aimlock (ล็อคกล้องหาเป้าหมาย)",
   CurrentValue = false,
   Flag = "AimlockToggle",
   Callback = function(Value)
       aimlockEnabled = Value
   end,
})

MainTab:CreateToggle({
   Name = "Shift Lock (เปิด/ปิด ชิฟต์ล็อค)",
   CurrentValue = false,
   Flag = "ShiftLockToggle",
   Callback = function(Value)
       toggleShiftLock(Value)
   end,
})

local function getCurrentTargetChar()
    if selectedTargetOption == "[คนใกล้ที่สุด / Closest]" or not selectedTargetOption then
        local closest = nil
        local shortestDist = math.huge
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return nil, 0 end
        local myPos = player.Character.HumanoidRootPart.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
                if plr.Character.Humanoid.Health > 0 then
                    local dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = plr.Character
                    end
                end
            end
        end
        return closest, shortestDist
    else
        for _, plr in ipairs(Players:GetPlayers()) do
            local fullName = plr.DisplayName .. " (@" .. plr.Name .. ")"
            if fullName == selectedTargetOption or plr.Name == selectedTargetOption then
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                    local dist = 0
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        dist = (plr.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                    end
                    return plr.Character, dist
                end
            end
        end
    end
    return nil, 0
end

MainTab:CreateButton({
   Name = "Warp to Target (วาร์ปไปหาเป้าหมาย 1 ครั้ง)",
   Callback = function()
       local target = getCurrentTargetChar()
       if target and target:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
           player.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
       else
           Rayfield:Notify({
               Title = "Warp Target",
               Content = "ไม่พบเป้าหมายที่เลือก!",
               Duration = 2,
               Image = 4483362458,
           })
       end
   end,
})

MainTab:CreateToggle({
   Name = "Auto Warp / Stick (วาร์ปสิงติดหลังออโต้)",
   CurrentValue = false,
   Flag = "AutoWarpToggle",
   Callback = function(Value)
       autoWarpEnabled = Value
   end,
})

-- TAB 2: FPS Booster
local FPSTab = Window:CreateTab("FPS Boost", 4483362458)

FPSTab:CreateButton({
   Name = "Boost FPS (เพิ่ม FPS / ลดกราฟิก)",
   Callback = function()
       Lighting.GlobalShadows = false
       Lighting.FogEnd = 9e9
       for _, obj in ipairs(Workspace:GetDescendants()) do
           if obj:IsA("BasePart") then
               obj.Material = Enum.Material.SmoothPlastic
               obj.Reflectance = 0
           elseif obj:IsA("Decal") or obj:IsA("Texture") then
               obj:Destroy()
           elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
               obj.Enabled = false
           end
       end
       Rayfield:Notify({
           Title = "FPS Booster",
           Content = "เพิ่ม FPS เรียบร้อยแล้ว!",
           Duration = 2,
           Image = 4483362458,
       })
   end,
})

-- =========================================================
-- 4. MAIN RENDER LOOP
-- =========================================================
RunService.RenderStepped:Connect(function()
    local targetChar, targetDist = getCurrentTargetChar()
    
    if targetChar then
        local targetPlr = Players:GetPlayerFromCharacter(targetChar)
        local displayName = targetPlr and (targetPlr.DisplayName .. " (@" .. targetPlr.Name .. ")") or targetChar.Name
        targetLabel:Set("🎯 เป้าหมาย: " .. displayName .. " [" .. math.floor(targetDist) .. "m]")

        if aimlockEnabled and targetChar:FindFirstChild("HumanoidRootPart") then
            camera.CFrame = CFrame.new(camera.CFrame.Position, targetChar.HumanoidRootPart.Position)
        end

        if autoWarpEnabled and targetChar:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    else
        targetLabel:Set("🎯 เป้าหมาย: ไม่พบผู้เล่นใกล้เคียง")
    end

    if shiftLockActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
        if player.Character.Humanoid.Health > 0 then
            player.Character.Humanoid.AutoRotate = false
            local lookVector = camera.CFrame.LookVector
            local hrp = player.Character.HumanoidRootPart
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(lookVector.X, 0, lookVector.Z))
        end
    end
end)
]])()
