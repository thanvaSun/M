-- Get Player List for Dropdown
local function getPlayerNames()
    local list = {"[คนใกล้ที่สุด / Closest]"}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            table.insert(list, plr.DisplayName .. " (@" .. plr.Name .. ")")
        end
    end
    return list
end

