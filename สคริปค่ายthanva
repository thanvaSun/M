}

-- =========================================================
-- CORE LOGIC: AIM ASSIST
-- =========================================================
local function getClosestTarget()
	local bestTarget = nil
	local bestDist = aimSettings.maxDist

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChild("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local dist = (hrp.Position - camera.CFrame.Position).Magnitude
				if dist >= aimSettings.minDist and dist <= bestDist then
					bestDist = dist
					bestTarget = hrp
				end
			end
		end
	end
	return bestTarget
end

local function getAimTarget()
	-- กรณีเลือกผู้เล่นเฉพาะคน
	if aimSettings.manualTarget and aimSettings.manualTarget.Parent then
		local targetChar = aimSettings.manualTarget.Character
		if targetChar then
			local hrp = targetChar:FindFirstChild("HumanoidRootPart")
			local hum = targetChar:FindFirstChild("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local dist = (hrp.Position - camera.CFrame.Position).Magnitude
				if dist >= aimSettings.minDist and dist <= aimSettings.maxDist then
					return hrp
				end
			end
		end
		return nil
	end

	-- กรณียังไม่ได้เลือก ให้ใช้อัตโนมัติ (ใกล้ที่สุด)
	return getClosestTarget()
end

RunService:BindToRenderStep("AimAssistSystem", Enum.RenderPriority.Camera.Value + 1, function()
	if not aimSettings.enabled then return end
	local targetHRP = getAimTarget()
	if not targetHRP then return end

	local currentLook = camera.CFrame.LookVector
	local toTarget = (targetHRP.Position - camera.CFrame.Position).Unit
	local blended = currentLook:Lerp(toTarget, aimSettings.strength)

	camera.CFrame = CFrame.new(camera.CFrame.Position, camera.CFrame.Position + blended)
end)

-- =========================================================
-- CORE LOGIC: POTATO GRAPHICS
-- =========================================================
local function setPotatoGraphics(enable)
	if enable then
		gfxSettings.originalLighting = {
			GlobalShadows = Lighting.GlobalShadows,
			FogEnd = Lighting.FogEnd,
			Brightness = Lighting.Brightness,
			Technology = Lighting.Technology,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
		}
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 100000
		Lighting.Technology = Enum.Technology.Compatibility
		Lighting.Brightness = 1
		Lighting.Ambient = Color3.fromRGB(150, 150, 150)
		Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)

		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") then
				gfxSettings.originalParts[obj] = {
					Material = obj.Material,
					Reflectance = obj.Reflectance,
					CastShadow = obj.CastShadow
				}
				obj.Material = Enum.Material.SmoothPlastic
				obj.Reflectance = 0
				obj.CastShadow = false
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				gfxSettings.hiddenObjects[obj] = obj.Transparency
				obj.Transparency = 1
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
				gfxSettings.hiddenObjects[obj] = obj.Enabled
				obj.Enabled = false
			end
		end
	else
		for prop, val in pairs(gfxSettings.originalLighting) do
			pcall(function() Lighting[prop] = val end)
		end
		for obj, data in pairs(gfxSettings.originalParts) do
			if obj and obj.Parent then
				obj.Material = data.Material
				obj.Reflectance = data.Reflectance
				obj.CastShadow = data.CastShadow
			end
		end
		for obj, val in pairs(gfxSettings.hiddenObjects) do
			if obj and obj.Parent then
				if obj:IsA("Decal") or obj:IsA("Texture") then
					obj.Transparency = val
				else
					obj.Enabled = val
				end
			end
		end
		gfxSettings.originalParts = {}
		gfxSettings.hiddenObjects = {}
	end
end

