local function createSlider(parent, titleText, min, max, defaultVal, callback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(0, 360, 0, 55)
	container.BackgroundColor3 = THEME.Card
	container.Parent = parent

	local cCorner = Instance.new("UICorner", container)
	cCorner.CornerRadius = UDim.new(0, 8)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -70, 0, 25)
	lbl.Position = UDim2.new(0, 15, 0, 5)
	lbl.BackgroundTransparency = 1
	lbl.Text = titleText
	lbl.TextColor3 = THEME.TextMain
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 13
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = container

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0, 50, 0, 25)
	valLbl.Position = UDim2.new(1, -60, 0, 5)
	valLbl.BackgroundTransparency = 1
	valLbl.Text = tostring(defaultVal)
	valLbl.TextColor3 = THEME.Accent
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 13
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.Parent = container

	local sliderBar = Instance.new("Frame")
	sliderBar.Size = UDim2.new(1, -30, 0, 6)
	sliderBar.Position = UDim2.new(0, 15, 0, 36)
	sliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
	sliderBar.Parent = container

	local barCorner = Instance.new("UICorner", sliderBar)
	barCorner.CornerRadius = UDim.new(1, 0)

	local fillBar = Instance.new("Frame")
	local initRatio = math.clamp((defaultVal - min) / (max - min), 0, 1)
	fillBar.Size = UDim2.new(initRatio, 0, 1, 0)
	fillBar.BackgroundColor3 = THEME.Accent
	fillBar.Parent = sliderBar

	local fillCorner = Instance.new("UICorner", fillBar)
	fillCorner.CornerRadius = UDim.new(1, 0)

	local sliding = false
	local function updateSlider(input)
		local posX = input.Position.X - sliderBar.AbsolutePosition.X
		local ratio = math.clamp(posX / sliderBar.AbsoluteSize.X, 0, 1)
		fillBar.Size = UDim2.new(ratio, 0, 1, 0)
		local value = math.floor((min + (max - min) * ratio) * 10) / 10
		valLbl.Text = tostring(value)
		callback(value)
	end

	sliderBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateSlider(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
end

