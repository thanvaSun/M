local aimSettings = {
	enabled = false,
	strength = 0.5, -- Range: 0.1 - 1.0
	minDist = 5,
	maxDist = 500,
	manualTarget = nil -- nil = อัตโนมัติ (ใกล้ที่สุด)
}

